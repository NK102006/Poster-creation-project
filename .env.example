# Shared by Vite (build time) and Node (runtime).
APP_BASE_PATH=/Poster-Creater
PORT=4017
HOST=127.0.0.1
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
# auto detects HTTPS from Apache; true requires HTTPS, false is for HTTP only.
COOKIE_SECURE=auto
# Optional: defaults to APP_BASE_PATH for uploaded image/video URLs.
# PUBLIC_BASE_URL=https://doctorly.in/Poster-Creater
# VITE_API_BASE_URL=/Poster-Creater/api
# UPLOADS_DIR=uploads
# SQLITE_PATH=/absolute/path/to/poster-creation.db
